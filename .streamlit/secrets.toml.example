# =============================================================
#  EXEMPLO DE CONFIGURACAO DE SEGREDOS
#  Copie este arquivo para  .streamlit/secrets.toml  e preencha.
#  No Streamlit Community Cloud, cole este conteudo em
#  "App settings" -> "Secrets".
#  NUNCA suba o secrets.toml real para o GitHub.
# =============================================================

# ---- Usuario MASTER / organizador do bolao --------------------
[admin]
usuario = "organizador"
senha   = "troque-esta-senha"
nome    = "Organizador do Bolao"

# ---- Planilha Google que funciona como banco de dados ---------
[gsheets]
# ID da planilha (parte da URL entre /d/ e /edit)
spreadsheet_id = "COLE_AQUI_O_ID_DA_PLANILHA"

# ---- API de futebol (football-data.org) -----------------------
# Crie uma chave gratuita em https://www.football-data.org/client/register
[api]
football_data_key = "COLE_AQUI_SUA_CHAVE_DA_API"

# ---- Credenciais da conta de servico do Google ----------------
# Baixe o JSON da conta de servico no Google Cloud e cole os campos abaixo.
[gcp_service_account]
type = "service_account"
project_id = "seu-projeto"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "bolao-copa@seu-projeto.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
